# Переменные сборки фронтенда. Все NUXT_PUBLIC_* попадают в клиентский бандл —
# логинов, паролей и токенов здесь быть не может.
# Значения для стенда и прода задаются в GitHub Environments, см. docs/deployment.md.

# Какой бэкенд использует приложение: gas | sql.
# Стенд — sql, прод пока gas. По умолчанию gas: безопасный откат.
NUXT_PUBLIC_ERP_BACKEND_MODE=gas

# Базовый путь SQL API. На хостинге отдаётся с того же домена.
NUXT_PUBLIC_ERP_API_BASE=/api

# Legacy-бэкенд на Google Apps Script: основной и складской Web App.
# Нужны, пока соответствующие разделы не переведены на SQL.
NUXT_PUBLIC_ERP_GAS_URL=
NUXT_PUBLIC_WAREHOUSE_GAS_URL=

# --- Локальная разработка -------------------------------------------------
# Полный стенд с настоящими PHP и MySQL: docs/onboarding/02-локальный-стенд.md.
# Доступы к базе там задаются приватным конфигом внутри .output/, а не здесь.

# ID Google-таблицы заказчика — только в секретах стенда/прода, не в git.
# NUXT_PUBLIC_ERP_SPREADSHEET_ID=
# NUXT_PUBLIC_ERP_ISSUE_SHEET_GID=

# Публичное демо (GitHub Pages): логин без GAS, бирки из моков.
# NUXT_PUBLIC_ERP_DEMO_MODE=true
